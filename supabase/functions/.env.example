# أسرار Edge Functions — انسخها إلى supabase/functions/.env محلياً، أو: supabase secrets set --env-file ...
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
APP_URL=http://localhost:3000
PUSH_SECRET=change-me-long-random
# Web Push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:it@sawaed.sa
# أندرويد: حساب خدمة Firebase (JSON في سطر واحد)
FCM_SERVICE_ACCOUNT=
# iOS: مفتاح APNs (.p8)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=sa.sawaed.supervision
APNS_PRODUCTION=false
# البريد الأسبوعي
RESEND_API_KEY=
MAIL_FROM=Sawaed <noreply@sawaed.sa>
