# Copy this file to .env and fill in your values:  cp .env.example .env
# Never commit .env - it contains secrets.

# ============================ Folders ============================
AUDIO_DIR=input/audio
BACKGROUNDS_DIR=input/backgrounds
OUTPUT_DIR=output
ARCHIVE_DIR=archive
STATE_DIR=state
LOG_DIR=logs
LOG_LEVEL=INFO

# ============================ Video ==============================
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
# Max seconds per video (keep under 60 to qualify as a Short everywhere)
MAX_DURATION=59
AUDIO_FADE_OUT=1.5
BACKGROUND_DIM=0.35
KEN_BURNS=true
RENDER_PRESET=medium
# RENDER_THREADS=4

# ========================= Transcription =========================
# tiny | base | small | medium | large-v3 | turbo  (bigger = better + slower)
WHISPER_MODEL=small
# ISO code (ar, en, ...). Leave empty for auto-detect.
WHISPER_LANGUAGE=ar
# cuda | cpu | empty = auto
WHISPER_DEVICE=

# ======================= Kinetic typography ======================
# Put an Arabic TTF in fonts/ (e.g. Cairo-Bold.ttf / Tajawal-Bold.ttf from Google Fonts)
FONT_PATH=fonts/Cairo-Bold.ttf
FONT_SIZE=96
TEXT_COLOR=#FFFFFF
HIGHLIGHT_COLOR=#FFD400
STROKE_COLOR=#000000
STROKE_WIDTH=6
WORDS_PER_CHUNK=4
TEXT_MAX_WIDTH=0.86
TEXT_POSITION_Y=0.62
CHUNK_GAP_SECONDS=1.0
POP_IN_SECONDS=0.12

# ========================== Scheduling ===========================
VIDEOS_PER_DAY=5
# Local time (HH:MM) at which the daily batch is rendered
DAILY_RUN_TIME=08:00
RUN_ON_START=true
FIRST_UPLOAD_DELAY_MINUTES=10
UPLOAD_INTERVAL_HOURS=3.5
UPLOAD_JITTER_MINUTES=20
MIN_UPLOAD_GAP_MINUTES=60
MAX_UPLOAD_ATTEMPTS=3
RETRY_DELAY_MINUTES=30
DELETE_VIDEO_AFTER_UPLOAD=false

# =========================== Metadata ============================
# "|"-separated. Placeholders: {name} = audio file name, {snippet} = first lyrics
TITLE_TEMPLATES={name} 🎵|Listen to this 🔥 {name}|{snippet}...|Wait for it 🎶 {name}
HASHTAGS=#Reels,#Shorts,#Trending,#Viral,#Music,#FYP,#Explore
EXTRA_DESCRIPTION=

# ========================== Platforms ============================
ENABLE_YOUTUBE=true
ENABLE_FACEBOOK=true
ENABLE_INSTAGRAM=true
ENABLE_TIKTOK=true

# --------------------------- YouTube -----------------------------
# OAuth "Desktop app" client JSON downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=state/youtube_token.json
# public | unlisted | private
YOUTUBE_PRIVACY=public
# 10 = Music, 22 = People & Blogs, 24 = Entertainment
YOUTUBE_CATEGORY_ID=10

# ------------------ Meta (Facebook + Instagram) ------------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
FACEBOOK_PAGE_ID=
# Long-lived Page token (python main.py --auth meta --token <short-lived user token>)
FACEBOOK_PAGE_ACCESS_TOKEN=
# Instagram professional account ID linked to the Page
INSTAGRAM_USER_ID=
# Leave empty to reuse FACEBOOK_PAGE_ACCESS_TOKEN
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_SHARE_TO_FEED=true

# ---------------------------- TikTok -----------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match a Redirect URI registered in the TikTok app (https)
TIKTOK_REDIRECT_URI=https://your-domain.com/tiktok/callback
# Filled automatically by `python main.py --auth tiktok` (saved in state/tiktok_token.json)
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_TOKEN_FILE=state/tiktok_token.json
# direct = publish immediately | inbox = send as draft to the TikTok app
TIKTOK_POST_MODE=direct
# Unaudited apps can ONLY post SELF_ONLY. After audit: PUBLIC_TO_EVERYONE
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

# ============================ Network ============================
HTTP_TIMEOUT=60
UPLOAD_TIMEOUT=900
PROCESSING_TIMEOUT=900
